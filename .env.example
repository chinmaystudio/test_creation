# Shared Supabase PostgreSQL database used by NeuroClass and the test portal.
DATABASE_URL=postgresql://...

# Must be identical in NeuroClass Vercel and this Render service.
# Generate with: openssl rand -base64 48
PORTAL_HANDOFF_SECRET=replace-with-a-long-random-secret

# OpenRouter question/test generation. Set these in the Render service environment only.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional app attribution headers.
OPENROUTER_HTTP_REFERER=https://test-creation-qwlp.onrender.com
OPENROUTER_APP_TITLE=NeuroClass Test Creation Portal

# Existing server-to-server proctoring configuration.
ML_PROCTORING_URL=https://neuroclass-ai-kktd.onrender.com
ML_PROCTORING_API_KEY=replace-with-ai-service-secret

# Local development only. Never enable in production.
DEV_AUTH_ENABLED=true
NODE_ENV=development

# Manus WebDev OAuth is intentionally not used by production.
# OAUTH_SERVER_URL is not required and must not be configured.
